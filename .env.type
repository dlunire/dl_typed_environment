# ============================================
# DL Typed Environment — Ejemplo de sintaxis
# ============================================

/**
 * Bloque de documentación.
 * Define las variables de entorno tipadas del proyecto DLUnire.
 */

# --- Identidad ---
AUTHOR: string = "David E Luna M"
PROJECT_NAME: string = 'DLUnire'
BRAND_SLUG: string = `dlunire-dark-cyber`

# --- Identificadores ---
SESSION_ID: uuid = 3fa85f64-5717-4562-b3fc-2c963f66afa6
ADMIN_EMAIL: email = david@dlunire.dev

# --- Numéricos ---
MAX_CONNECTIONS: integer = 100
MIN_CONNECTIONS_: integer = 1
PI_VALUE: numeric = 3.1415926535
TIMEOUT: numeric = -5

// Comentario de una línea con doble slash
DISCOUNT_RATE: float = 0.15

# --- Booleanos ---
PRODUCTION: boolean = true
DEBUG_MODE: boolean = false

# --- Expresiones (variable como valor) ---
TOTAL_CONNECTIONS: integer = MAX_CONNECTIONS + MIN_CONNECTIONS_
AVERAGE_LOAD: numeric = PI_VALUE / 2.0
REMAINING_SLOTS: integer = MAX_CONNECTIONS - TOTAL_CONNECTIONS
THRESHOLD_CHECK: boolean = TOTAL_CONNECTIONS < MAX_CONNECTIONS

/** 
 * Aquí se permite documentar el comentario para que puedas saber
 * de qué trata tu variable que has definido en este formato.
 */
VARIABLE_PRUEBA: string = "Documentación de la variable"

/** 
 * Permite indicarle a la aplicación que permita el uso de una base de
 * datos independiente por dominio o subdominio.
 */
MULTITENANT: boolean = true

VALUE: integer = 100

